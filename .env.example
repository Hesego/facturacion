# Copie este archivo como .env y cambie TODAS las claves antes de usarlo fuera de un equipo local.

# --- PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario
# Dueño del esquema: ejecuta migraciones y semillas
GASTOS_OWNER_PASSWORD=cambiar-owner
# Rol con el que se conecta la aplicación (no puede editar ni borrar el historial)
GASTOS_APP_PASSWORD=cambiar-app
# Rol restringido de n8n: lee vistas de SLA y escribe en notificaciones_log
GASTOS_N8N_PASSWORD=cambiar-n8n-gastos
# Base interna de n8n (sus workflows y credenciales)
N8N_DB_PASSWORD=cambiar-n8n-db

# --- Semillas ---
ADMIN_EMAIL=admin@hesego.test
ADMIN_NOMBRE=Administrador del sistema
ADMIN_PASSWORD=cambiar-admin
# true = crea áreas, usuarios y proveedores de prueba. Use false en producción.
SEED_DEMO=true
DEMO_PASSWORD=Hesego2026*

# --- Almacenamiento de objetos (MinIO / S3) ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar-minio-root
S3_BUCKET=gastos-soportes
S3_ACCESS_KEY=gastos-app
S3_SECRET_KEY=cambiar-s3-secret

# --- n8n ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
# Genere una con: openssl rand -hex 32  (no la cambie después: cifra las credenciales de n8n)
N8N_ENCRYPTION_KEY=cambiar-por-64-caracteres-hex
# Token compartido entre la aplicación y el webhook de n8n
N8N_WEBHOOK_TOKEN=cambiar-token-webhook

# --- Correo ---
MAILPIT_UI_PORT=8025
MAIL_FROM=Gastos Hesego <gastos@hesego.test>
# Local: Mailpit atrapa todo (bandeja en http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Producción con Microsoft 365 (requiere SMTP AUTH habilitado para el buzón):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false            (587 usa STARTTLS)
# SMTP_USER=gastos@hesegoingenieria.com
# SMTP_PASSWORD=...
# MAIL_FROM=Gastos Hesego <gastos@hesegoingenieria.com>   (debe ser el mismo buzón o uno con permiso «Enviar como»)

# --- Aplicación ---
APP_URL=http://localhost:8080
API_PORT=3000
# La aplicación (interfaz) queda en http://localhost:WEB_PORT
WEB_PORT=8080
# Duración de la sesión de usuario
SESION_HORAS=10
# true en producción (requiere HTTPS)
COOKIE_SECURE=false
